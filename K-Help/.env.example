# Copy to .env and adjust for your machine.
POSTGRES_DB=khelp
POSTGRES_USER=khelp
POSTGRES_PASSWORD=khelp
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8080
FRONTEND_PORT=3000

# JWT signing secret - must be at least 32 characters (HS256).
APP_JWT_SECRET=khelp-super-secret-development-key-change-me-in-production-0123456789

# External LLM provider used by the AI middleware module.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# "true" answers AI requests locally without calling the provider. Set to "false"
# together with a real AI_API_KEY to use the external LLM.
AI_MOCK_MODE=true

# Comma-separated browser origins allowed to call the API.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:*

NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
